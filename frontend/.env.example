# ==========================================================================
# LeadGen frontend environment (Vite — only VITE_* keys reach the browser)
# Copy to frontend/.env and fill in the values. Restart `npm run dev` after edits.
# ==========================================================================

# Backend base URL including the API prefix
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase web app config (Project settings → General → Your apps)
# Push notifications stay disabled until API key + VAPID key are set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
