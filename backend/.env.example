# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Database Configuration (MongoDB Atlas - Appzeto Database)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/Appzeto?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins
CORS_ORIGIN=*

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Firebase Cloud Messaging Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# SMS Gateway Configuration
SMS_API_KEY=your_sms_gateway_api_key
SMS_SENDER_ID=APPZTO

# Google Gemini (free tier - get a key at https://aistudio.google.com/apikey)
# Powers the AI response draft assistant. Leave blank to disable that feature.
GEMINI_API_KEY=your_gemini_api_key

# ML Scoring Microservice (backend/ml-service - local Python/FastAPI, no cloud cost)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_API_KEY=change_this_to_a_random_shared_secret

# Lead Ingestion Webhook Signing (generate with: openssl rand -hex 32)
LEAD_INGEST_WEBHOOK_SECRET=change_this_to_a_random_secret
