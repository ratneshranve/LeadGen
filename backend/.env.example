# ==========================================================================
# LeadGen backend environment
# Copy to backend/.env and fill in the values. Validated in config/env.js.
# Keys marked REQUIRED must be set or the server refuses to start.
# Keys with a value below must not be left empty (Joi rejects "").
# ==========================================================================

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Comma-separated list or * (e.g. http://localhost:5173,https://your-app.vercel.app)
CORS_ORIGIN=*

# --- Database (REQUIRED) --------------------------------------------------
MONGODB_URI=

# --- JWT (REQUIRED) -------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d

# --- Cloudinary (file uploads) --------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase Admin (push notifications via FCM) --------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n escapes exactly as in the service-account JSON
FIREBASE_PRIVATE_KEY=

# --- SMS / OTP ------------------------------------------------------------
# mock | fast2sms | smsindiahub
SMS_PROVIDER=mock
# Fast2SMS
SMS_API_KEY=
SMS_SENDER_ID=
# SMS India Hub (DLT)
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
SMS_INDIA_HUB_ENTITY_ID=
SMS_BRAND_NAME=LeadGen
SMS_INDIA_HUB_MESSAGE_TEMPLATE=
# Testing only: skip SMS and accept DEFAULT_OTP for every login
USE_DEFAULT_OTP=false
DEFAULT_OTP=123456

# --- AI / ML --------------------------------------------------------------
GEMINI_API_KEY=
ML_SERVICE_URL=http://localhost:8001
# Must match ML_SERVICE_API_KEY in backend/ml-service/.env
ML_SERVICE_API_KEY=

# --- Lead ingestion webhooks ----------------------------------------------
LEAD_INGEST_WEBHOOK_SECRET=
